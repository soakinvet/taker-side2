{
  "name": "taker-side",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 4177",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4177",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "pack": "npm run build && mkdir -p release && evenhub pack app.json dist --sdk-ver 0.0.16 -o release/taker-side.ehpk",
    "simulate": "node ./node_modules/@evenrealities/evenhub-simulator/bin/index.js http://127.0.0.1:4177"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
